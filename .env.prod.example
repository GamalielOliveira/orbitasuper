# Copie para .env.prod NA VPS (nunca no git) e preencha. chmod 600 .env.prod
DOMINIO=super.orbitacode.cloud

# Banco (senha longa: openssl rand -base64 32 | tr -d '/+=')
POSTGRES_USER=super
POSTGRES_DB=super
POSTGRES_PASSWORD=

# Login (openssl rand -hex 32)
JWT_SECRET=

# CORS: mesmo domínio do site
CORS_ORIGINS=https://super.orbitacode.cloud

# Traccar (nome interno do container na VPS)
TRACCAR_URL=http://orbitacode-traccar-1:8082
TRACCAR_USER=
TRACCAR_PASS=

# Traefik (o bloco B confere na VPS)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRACCAR_NETWORK=orbitacode_default
